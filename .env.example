CONTROL_PLANE_IP=192.168.0.151
APP_VERSION=2.7.1

# Stage 2 resource controls
API_RATE_LIMIT_PER_MINUTE=240
SSH_MAX_CONCURRENCY=8
MAINTENANCE_WORKER_CONCURRENCY=2
MAINTENANCE_WORKER_POLL_SECONDS=2
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.5
API_MEMORY_LIMIT=768m
API_CPU_LIMIT=1.5
WORKER_MEMORY_LIMIT=512m
WORKER_CPU_LIMIT=1.0
BACKUP_MEMORY_LIMIT=512m
BACKUP_CPU_LIMIT=1.0
UI_MEMORY_LIMIT=512m
UI_CPU_LIMIT=1.0
GATEWAY_MEMORY_LIMIT=128m
GATEWAY_CPU_LIMIT=0.5
POSTGRES_DB=linux_ai
POSTGRES_USER=linux_ai
POSTGRES_PASSWORD=please-change-this-lab-password
# 預設只允許中央本機連線；啟用串流複寫時才改為中央的區網 IP。
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PRIMARY_HOST=192.168.0.151
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICATION_USER=linux_ai_replication
POSTGRES_REPLICATION_PASSWORD=
POSTGRES_REPLICATION_SLOT=linux_ai_standby
SSH_KEY_PATH=/home/nickc/.ssh/linux_ai_agent
KNOWN_HOSTS_PATH=/home/nickc/.ssh/known_hosts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-admin-password
ADMIN_DISPLAY_NAME=平台管理員
SESSION_HOURS=8
COOKIE_SECURE=false
MONITOR_INTERVAL_SECONDS=60
METRIC_RETENTION_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_TO_NUMBER=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 多個收件者以逗號分隔
SMTP_TO=
SMTP_USE_TLS=true
NOTIFICATION_TIMEOUT_SECONDS=8
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_POLL_SECONDS=10
WATCHDOG_SHARED_TOKEN=
WATCHDOG_STALE_SECONDS=120
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
AI_DIAGNOSTIC_MODE=local
UBUNTU_SECURITY_API_URL=https://ubuntu.com/security/notices.json
UBUNTU_SECURITY_CACHE_SECONDS=3600
CENTRAL_LOG_INTERVAL_SECONDS=300
CENTRAL_LOG_RETENTION_DAYS=30
MAINTENANCE_APPROVAL_TTL_MINUTES=60
# 正式使用請填入：openssl rand -base64 32（設定後不可任意更換，否則既有加密資料無法解密）
PLATFORM_MASTER_KEY=
